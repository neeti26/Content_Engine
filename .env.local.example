# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get free keys at: https://aistudio.google.com/app/apikey
# Add up to 10 keys for rotation (reduces rate limit hits)
GEMINI_API_KEY_1=your-gemini-key-1
GEMINI_API_KEY_2=your-gemini-key-2
GEMINI_API_KEY_3=your-gemini-key-3

# ─── Creatomate ────────────────────────────────────────────────────────────────
# Get key at: https://creatomate.com (free trial available)
# Required for actual video Reel rendering
CREATOMATE_API_KEY=your-creatomate-key

# ─── Clerk Auth ────────────────────────────────────────────────────────────────
# Get keys at: https://clerk.com (free up to 10,000 MAU)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get keys at: https://supabase.com (free tier: 500MB storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
